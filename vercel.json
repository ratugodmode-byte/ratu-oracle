{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/.netlify/functions/:function",
      "destination": "/api/:function"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/promotion",
      "destination": "/promotion.html"
    },
    {
      "source": "/free-tarot",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/free-online-tarot",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/free-tarot-reading",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/free-online-tarot-reading",
      "destination": "/free-tarot-reading.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
