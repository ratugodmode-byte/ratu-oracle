{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/.netlify/functions/:function",
      "destination": "/api/:function"
    },
    {
      "source": "/sitemap-dynamic.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/submit-to-crawlers",
      "destination": "/api/indexnow-submit"
    },
    {
      "source": "/id",
      "destination": "/index.html"
    },
    {
      "source": "/zh",
      "destination": "/index.html"
    },
    {
      "source": "/ru",
      "destination": "/index.html"
    },
    {
      "source": "/id/spirit-dolls",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/zh/spirit-dolls",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/ru/spirit-dolls",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/id/spirit-dolls/:slug",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/zh/spirit-dolls/:slug",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/ru/spirit-dolls/:slug",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/id/free-tarot-reading",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/zh/free-tarot-reading",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/ru/free-tarot-reading",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/promotion",
      "destination": "/promotion.html"
    },
    {
      "source": "/free-tarot",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/free-online-tarot",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/free-tarot-reading",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/free-online-tarot-reading",
      "destination": "/free-tarot-reading.html"
    },
    {
      "source": "/spirit-dolls",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/spirit-doll",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/magickal-objects",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/amulets-talismans",
      "destination": "/spirit-dolls-magickal-objects.html"
    },
    {
      "source": "/indotalisman",
      "destination": "/indotalisman.html"
    },
    {
      "source": "/indotalisman-admin",
      "destination": "/indotalisman-admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
